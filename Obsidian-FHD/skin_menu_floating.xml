<?xml version="1.0" encoding="UTF-8"?>
<!-- "Floating" menu style: floating rounded columns over live TV. Loaded only when /etc/enigma2/obsidian_menu_floating
     exists (Obsidian FHD Settings > Menu style); it replaces the classic screens of skin_menus.xml.
     One "menu" list per screen only: OpenATV gets the icon list (conditional "menuimage"), other images the
     text list ("excludes", ignored by images without it). Selection = window/sel_floating_*.png (tools/floating-graphics.ps1). -->
<skin>
	<screen name="menu_mainmenu" position="fill" flags="wfNoBorder" backgroundColor="transparent">
		<eLabel position="80,100" size="520,752" backgroundColor="aCard" borderWidth="1" borderColor="aLine" cornerRadius="24" zPosition="1" />
		<!-- card header: logo, title, clock -->
		<ePixmap pixmap="icons/menu_header.png" position="116,122" size="40,40" alphatest="off" zPosition="2" />
		<panel name="FloatingMainTitle" />
		<widget source="global.CurrentTime" render="Label" position="420,122" size="144,40" font="SemiBold;26" foregroundColor="aText" backgroundColor="aCard" transparent="1" halign="right" valign="center" zPosition="2">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<eLabel position="116,180" size="448,1" backgroundColor="aLine" zPosition="2" />
		<widget source="menu" render="Listbox" conditional="menuimage" position="81,196" size="518,544" selectionPixmap="window/sel_floating_main.png" backgroundColor="aCard" foregroundColor="aVariant" backgroundColorSelected="aCard" foregroundColorSelected="aWhite" transparent="1" enableWrapAround="1" scrollbarMode="showOnDemand" scrollbarWidth="4" scrollbarSliderBorderWidth="0" scrollbarSliderForegroundColor="aAccent" zPosition="2">
			<convert type="TemplatedMultiContent">
				{"template": [
					MultiContentEntryPixmapAlphaBlend(pos = (51,14), size = (40,40), png = 1, flags = BT_SCALE | BT_KEEP_ASPECT_RATIO),
					MultiContentEntryText(pos = (111,0), size = (368,68), flags = RT_HALIGN_LEFT | RT_VALIGN_CENTER, text = 0)
				],
		"fonts": [gFont("Regular",30)],
		"itemHeight": 68
	}
			</convert>
