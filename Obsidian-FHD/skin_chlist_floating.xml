<!-- Floating channel list (optional, Obsidian FHD Settings > Channel list style > Floating, flag
     /etc/enigma2/obsidian_chlist_floating). Solid cards over live TV, same style as the Floating menu:
     list card (header with the screen title and clock, rows with the Floating selection), a card for the selected
     channel's programme (hidden in the bouquet view, where there is no programme) and a card with the colour keys.
     The row content (programme line, progress bar, picons) follows the image's own channel list settings. -->
<skin>
	<!-- Header title and channel name: plain here; skin_sysinfo.xml redefines them with the Obsidian converters when they
	     are installed (title shortened to the bouquet name, channel name shown above the programme). -->
	<screen name="ChlistTitle">
		<widget source="Title" render="Label" position="166,74" size="520,40" font="MonoBold;19" foregroundColor="aAccent" backgroundColor="aCard" transparent="1" noWrap="1" valign="center" zPosition="1" />
	</screen>
	<screen name="ChlistChannelName" />
	<!-- stream / transponder line: only with the Obsidian converters (shown only when the programme card is shown) -->
	<screen name="ChlistTransponder" />
	<screen name="ChannelSelection" position="fill" title="Channel Selection" backgroundColor="transparent" flags="wfNoBorder">
		<!-- list card -->
		<eLabel position="80,60" size="760,900" backgroundColor="aCard" cornerRadius="24" zPosition="-1" />
		<ePixmap pixmap="icons/menu_header.png" position="112,73" size="40,40" alphatest="blend" zPosition="1" />
		<panel name="ChlistTitle" />
		<widget source="global.CurrentTime" render="Label" position="690,74" size="114,40" font="SemiBold;28" foregroundColor="aWhite" backgroundColor="aCard" transparent="1" halign="right" valign="center" zPosition="1">
			<convert type="ClockToText">Format:%H:%M</convert>
