<?xml version="1.0" encoding="UTF-8"?>
<!-- Nova infobar: today's weather in the capsule (icon + temperature). Loaded only with the Nova style and OAWeather. -->
<skin>
	<screen name="NovaWeather">
		<widget source="session.OAWeather" render="OAWeatherPixmap" position="1586,950" size="62,62" alphatest="blend" scale="1" transparent="1" zPosition="2">
			<convert type="OAWeather">weathericon,current</convert>
		</widget>
		<widget source="session.OAWeather" render="Label" position="1650,950" size="80,62" font="Bold;40" foregroundColor="nPeach" backgroundColor="nNavy" transparent="1" noWrap="1" valign="center" halign="right" zPosition="2">
			<convert type="OAWeather">temperature_current</convert>
		</widget>
	</screen>
</skin>
