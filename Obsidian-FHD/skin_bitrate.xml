<?xml version="1.0" encoding="UTF-8"?>
<!-- Video / audio bitrate: card under the clock in the infobar, line in the second infobar telemetry header (satellite,
     cable, terrestrial channels). Off with /etc/enigma2/obsidian_nobitrate (Obsidian FHD Settings).
     Loaded only when the ObsidianBitrate converter and the BitrateViewer plugin's calculator exist; hidden on IPTV. -->
<skin>
	<screen name="BitrateLine">
		<widget source="session.CurrentService" render="FixedLabel" text="VIDEO" position="640,552" size="80,30" backgroundColor="aCard" foregroundColor="aMuted" transparent="1" font="MonoBold;17" valign="center" zPosition="1">
			<convert type="ObsidianBitrate">Video</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.CurrentService" render="Label" position="720,552" size="220,30" backgroundColor="aCard" foregroundColor="aAccent" transparent="1" font="MonoBold;20" noWrap="1" valign="center" zPosition="1">
			<convert type="ObsidianBitrate">Video</convert>
		</widget>
		<widget source="session.CurrentService" render="FixedLabel" text="AUDIO" position="960,552" size="80,30" backgroundColor="aCard" foregroundColor="aMuted" transparent="1" font="MonoBold;17" valign="center" zPosition="1">
			<convert type="ObsidianBitrate">Audio</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.CurrentService" render="Label" position="1040,552" size="220,30" backgroundColor="aCard" foregroundColor="aAmber" transparent="1" font="MonoBold;20" noWrap="1" valign="center" zPosition="1">
			<convert type="ObsidianBitrate">Audio</convert>
		</widget>
	</screen>
	<!-- main infobar: bitrate card under the clock card (no weather bar); skin_bitrate_weather.xml moves it under the weather bar -->
	<screen name="InfoBarBitrate">
		<widget source="session.CurrentService" render="FixedLabel" position="1600,168" size="280,96" backgroundColor="aCard" borderWidth="1" borderColor="aLine" cornerRadius="14" zPosition="2">
			<convert type="ObsidianBitrate">Video</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.CurrentService" render="FixedLabel" text="BITRATE" position="1620,176" size="240,28" backgroundColor="aCard" foregroundColor="aMuted" transparent="1" font="MonoBold;15" valign="center" zPosition="3">
			<convert type="ObsidianBitrate">Video</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.CurrentService" render="FixedLabel" text="VIDEO" position="1620,204" size="100,28" backgroundColor="aCard" foregroundColor="aMuted" transparent="1" font="Mono;15" valign="center" zPosition="3">
			<convert type="ObsidianBitrate">Video</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.CurrentService" render="Label" position="1700,204" size="160,28" backgroundColor="aCard" foregroundColor="aAccent" transparent="1" font="MonoBold;20" halign="right" valign="center" noWrap="1" zPosition="3">
			<convert type="ObsidianBitrate">Video</convert>
		</widget>
		<widget source="session.CurrentService" render="FixedLabel" text="AUDIO" position="1620,230" size="100,28" backgroundColor="aCard" foregroundColor="aMuted" transparent="1" font="Mono;15" valign="center" zPosition="3">
			<convert type="ObsidianBitrate">Audio</convert>
			<convert type="ConditionalShowHide" />
		</widget>
		<widget source="session.CurrentService" render="Label" position="1700,230" size="160,28" backgroundColor="aCard" foregroundColor="aAmber" transparent="1" font="MonoBold;20" halign="right" valign="center" noWrap="1" zPosition="3">
			<convert type="ObsidianBitrate">Audio</convert>
		</widget>
	</screen>
</skin>
